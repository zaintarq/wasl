# Copy to `.env` in the project root (same folder as package.json). One file for Expo + Functions.

# --- Expo (public URL only; embedded in app if prefixed EXPO_PUBLIC_) ---
EXPO_PUBLIC_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud

# ZoiVera age verification (public key — origin-lock with ZoiVera for production)
EXPO_PUBLIC_ZOIVERA_API_KEY=
# Leave unset to use bundled in-app scanner. Set only if you host docs/age-verify.html yourself.
# EXPO_PUBLIC_AGE_VERIFY_URL=https://your-domain/age-verify.html
EXPO_PUBLIC_ZOIVERA_AUDIENCE=https://zaintarq.github.io
EXPO_PUBLIC_AGE_VERIFY_HOST_URL=https://us-central1-huzz-10264.cloudfunctions.net/ageVerifyPage

# --- Cloud Functions (ZoiVera — server-side key for hosted scanner page) ---
ZOIVERA_AUDIENCE=https://zaintarq.github.io
ZOIVERA_API_KEY=

# --- LiveKit / server (token minting; not bundled in app) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Huzz Games (Colyseus + Phaser — free stack) ---
# Same GAME_SESSION_SECRET on Functions + Colyseus server (games/server).
# Build client: npm run games:build  →  served from games/server/public
EXPO_PUBLIC_GAMES_CLIENT_URL=http://YOUR_LAN_IP:2567
EXPO_PUBLIC_COLYSEUS_WS_URL=ws://YOUR_LAN_IP:2567
GAMES_CLIENT_URL=http://YOUR_LAN_IP:2567
COLYSEUS_WS_URL=ws://YOUR_LAN_IP:2567
COLYSEUS_PORT=2567
GAME_SESSION_SECRET=

# --- Cloud Functions (local emulator; use Firebase secrets/config in production) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WARNING_SMTP_USER=
WARNING_SMTP_PASSWORD=

# Optional OneID / other function env vars — add here if you use them locally
# ONEID_AUTHORIZE_URL=
# ONEID_CLIENT_ID=
