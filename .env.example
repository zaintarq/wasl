# Copy to `.env` in the project root (same folder as package.json). One file for Expo + Functions.

# --- Expo (public URL only; embedded in app if prefixed EXPO_PUBLIC_) ---
EXPO_PUBLIC_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud

# --- LiveKit / server (token minting; not bundled in app) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloud Functions (local emulator; use Firebase secrets/config in production) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WARNING_SMTP_USER=
WARNING_SMTP_PASSWORD=

# Optional OneID / other function env vars — add here if you use them locally
# ONEID_AUTHORIZE_URL=
# ONEID_CLIENT_ID=
