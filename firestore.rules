rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isDisabled() {
      // If user doc doesn't exist yet, they're not disabled (allow onboarding)
      return isSignedIn()
        && exists(userDocPath(request.auth.uid))
        && get(userDocPath(request.auth.uid)).data.isDisabled == true;
    }
    
    function userDocExists(uid) {
      return exists(userDocPath(uid));
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || request.auth.token.role == 'admin'
        || (
          exists(/databases/$(database)/documents/admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid && !isDisabled();
    }

    function isMatchParticipant() {
      return isSignedIn()
        && !isDisabled()
        && resource.data.uids is list
        && resource.data.uids.hasAny([request.auth.uid]);
    }

    // Same as isMatchParticipant but allows requestedBy/requestedTo when uids missing (e.g. legacy)
    function isMatchParticipantOrRequestParty() {
      return isSignedIn()
        && !isDisabled()
        && (
          (resource.data.uids is list && resource.data.uids.hasAny([request.auth.uid]))
          || (resource.data.requestedBy == request.auth.uid || resource.data.requestedTo == request.auth.uid)
        );
    }

    function isPendingMatchParty() {
      return isSignedIn()
        && !isDisabled()
        && resource.data.status == 'pending'
        && (
          resource.data.requestedTo == request.auth.uid
          || resource.data.requestedBy == request.auth.uid
        );
    }

    function canListMatch() {
      return isMatchParticipant() || isPendingMatchParty();
    }

    // Helper: can user send messages in this match? (match doc must exist and be active)
    function canSendMessageInMatch(matchId) {
      let path = /databases/$(database)/documents/matches/$(matchId);
      return exists(path)
        && get(path).data.get('status', '') == 'active'
        && get(path).data.get('isBlocked', false) != true
        && (
          (get(path).data.uids is list && get(path).data.uids.hasAny([request.auth.uid]))
          || (get(path).data.get('requestedBy', '') == request.auth.uid || get(path).data.get('requestedTo', '') == request.auth.uid)
        );
    }

    function mehramAccessPath(accessId) {
      return /databases/$(database)/documents/mehramAccess/$(accessId);
    }

    function mehramAccessIdFromAuth() {
      return request.auth.token.get('mehramAccessId', '');
    }

    function isMehramAuth() {
      return request.auth != null
        && request.auth.token.get('mehram', false) == true
        && mehramAccessIdFromAuth() is string
        && mehramAccessIdFromAuth().size() > 0;
    }

    function mehramAccessActiveForMatch(matchId) {
      return isMehramAuth()
        && request.auth.token.get('matchId', '') == matchId
        && exists(mehramAccessPath(mehramAccessIdFromAuth()))
        && get(mehramAccessPath(mehramAccessIdFromAuth())).data.get('status', '') == 'active'
        && get(mehramAccessPath(mehramAccessIdFromAuth())).data.get('matchId', '') == matchId
        && get(mehramAccessPath(mehramAccessIdFromAuth())).data.get('expiresAt', request.time) > request.time;
    }

    function canMehramReplyInMatch(matchId) {
      return mehramAccessActiveForMatch(matchId)
        && get(mehramAccessPath(mehramAccessIdFromAuth())).data.get('permission', '') == 'reply';
    }

    function isMatchGirlForMehram(matchId) {
      return isSignedIn()
        && !isDisabled()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && get(/databases/$(database)/documents/matches/$(matchId)).data.get('mehram', null) != null
        && get(/databases/$(database)/documents/matches/$(matchId)).data.mehram.get('girlUid', '') == request.auth.uid;
    }

    function clubMemberPath(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }

    function isClubMember(clubId) {
      return isSignedIn()
        && !isDisabled()
        && exists(clubMemberPath(clubId));
    }

    function clubMemberRole(clubId) {
      return get(clubMemberPath(clubId)).data.role;
    }

    function isClubAdmin(clubId) {
      return isClubMember(clubId)
        && clubMemberRole(clubId) in ['owner', 'admin'];
    }

    // Users
    match /users/{uid} {
      // Allow users to create their own document (onboarding)
      allow create: if isSignedIn() && request.auth.uid == uid;

      // Signed-in users can read profiles for discovery (web + app)
      allow read: if isSignedIn() && (
        request.auth.uid == uid || !isDisabled()
      );

      // Owners can update their profile
      // Cannot self-promote to admin or disable themselves.
      // Can update any field except isDisabled
      // Note: role is no longer stored in users collection, so we don't need to check for it
      // setDoc with merge: if doc exists, uses update rule; if doc doesn't exist, uses create rule
      // SIMPLIFIED: Allow update if user owns the document and is signed in
      // Only restriction: cannot change isDisabled field
      allow update: if (
        isSignedIn() 
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).changedKeys().hasAny([
          'isDisabled',
          'isShadowBanned',
          'ageChecked18Plus',
          'ageCheckAt',
          'ageCheckMethod',
          'ageCheckProvider',
          'ageCheckJti',
        ])
      ) || isAdmin();
      
      // Allow setDoc with merge (used in setUser function)
      // This is needed for onboarding when document might not exist yet
      // setDoc with merge will use update rule if doc exists, create rule if it doesn't
      allow create: if isSignedIn() && request.auth.uid == uid;

      allow delete: if isAdmin();

      match /clubMemberships/{clubId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          || isClubAdmin(clubId)
          || (
            isSignedIn()
            && !isDisabled()
            && request.auth.uid == uid
            && request.resource.data.role == 'owner'
            && exists(/databases/$(database)/documents/clubs/$(clubId))
            && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid
          );
        allow update: if isOwner(uid) || isClubAdmin(clubId);
        allow delete: if isOwner(uid) || isClubAdmin(clubId);
      }

      // Per-user subcollections
      match /likesSent/{otherUid} {
        // users/{likerUid}/likesSent/{targetUid} — only the liker (uid) writes; toUid must match doc id segment
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.toUid == otherUid
          && request.resource.data.action in ['like', 'pass'];
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) || (isSignedIn() && request.auth.uid == otherUid && !isDisabled());
      }
      match /likesReceived/{otherUid} {
        // users/{targetUid}/likesReceived/{likerUid} — liker writes to recipient's subcollection (auth == liker doc id)
        allow read: if isOwner(uid);
        allow create, update: if isSignedIn()
          && request.auth.uid == otherUid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUid == otherUid
          && request.resource.data.action in ['like', 'pass'];
        allow delete: if isOwner(uid) || (isSignedIn() && request.auth.uid == otherUid && !isDisabled());
      }
      match /blocks/{otherUid} {
        allow read, write, delete: if isOwner(uid);
      }
      match /contactHashes/{hash} {
        allow read, write, delete: if isOwner(uid);
      }

      // Per-user notifications bucket.
      // - Any signed-in user can CREATE a notification for someone else, but only as themselves (fromUid).
      // - Only the owner can read/mark read.
      match /notifications/{notificationId} {
        allow create: if isSignedIn()
          && !isDisabled()
          && request.resource.data.toUid == uid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.title is string
          && request.resource.data.body is string;

        allow get, list, update, delete: if isOwner(uid);
      }

      // Story "seen" markers — viewer tracks which authors they finished watching.
      match /storySeen/{authorUid} {
        allow read, write: if isOwner(uid);
      }
    }

    // Ephemeral user stories (24h). Online users post via app; all signed-in users can read active stories.
    match /stories/{storyId} {
      allow read: if isSignedIn() && !isDisabled();

      allow create: if isSignedIn()
        && !isDisabled()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() > 8
        && request.resource.data.mediaType == 'image'
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      allow delete: if isSignedIn()
        && !isDisabled()
        && resource.data.userId == request.auth.uid;

      allow update: if false;

      // Who viewed this story (viewer writes own doc; author can read list).
      match /views/{viewerUid} {
        allow read: if isSignedIn()
          && !isDisabled()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;

        allow create, update: if isSignedIn()
          && !isDisabled()
          && request.auth.uid == viewerUid
          && request.resource.data.viewerUid == request.auth.uid
          && request.resource.data.viewerName is string;
      }
    }

    // Multiplayer game rooms (Phase 2 glue — created by getGameLaunchSession).
    match /gameRooms/{roomId} {
      allow read: if isSignedIn()
        && !isDisabled()
        && request.auth.uid in resource.data.uids;

      allow create, update: if false;
      allow delete: if false;
    }

    // Matches
    match /matches/{matchId} {
      // Create: full match (uids list) or pending match request (requestedBy/requestedTo)
      // Client writes: id, uids[], status, requestedBy, requestedTo, approvedBy, approvedAt, createdAt, lastMessageAt
      allow create: if isSignedIn()
        && !isDisabled()
        && (
          (
            request.resource.data.uids is list
            && request.resource.data.uids.size() == 2
            && (
              request.resource.data.uids[0] == request.auth.uid
              || request.resource.data.uids[1] == request.auth.uid
            )
          )
          || (
            request.resource.data.status == 'pending'
            && request.resource.data.requestedBy is string
            && request.resource.data.requestedBy == request.auth.uid
            && request.resource.data.requestedTo is string
            && request.resource.data.requestedTo != request.auth.uid
          )
        );

      // List: participant in uids[] (array-contains queries)
      allow list: if isSignedIn() && !isDisabled() && isMatchParticipant();
      // Allow get when doc doesn't exist (so client can check before create) or when user is participant/admin
      allow get: if !exists(/databases/$(database)/documents/matches/$(matchId))
        || isMatchParticipantOrRequestParty()
        || isAdmin();
      // Participants can update match docs (status, lastMessageAt, typing, etc.)
      allow update: if isMatchParticipantOrRequestParty() || isAdmin();
      // Participants can delete (unmatch); admins can delete any match
      allow delete: if isAdmin() || isMatchParticipantOrRequestParty();

      // Messages within a match
      match /messages/{messageId} {
        allow get, list: if (isAdmin())
          || (isSignedIn() && !isDisabled() && canSendMessageInMatch(matchId))
          || mehramAccessActiveForMatch(matchId);

        allow create: if isSignedIn()
          && !isDisabled()
          && (
            (
              canSendMessageInMatch(matchId)
              && request.resource.data.fromUid == request.auth.uid
              && (
                // Text message
                (
                  request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() <= 2000
                )
                // Voice note message
                || (
                  request.resource.data.type == 'voice'
                  && request.resource.data.audioUrl is string
                  && request.resource.data.audioUrl.size() > 8
                  && request.resource.data.durationMs is int
                  && request.resource.data.durationMs >= 1000
                  && request.resource.data.durationMs <= 15000
                )
              )
            )
            || (
              canMehramReplyInMatch(matchId)
              && request.resource.data.senderType == 'mehram'
              && request.resource.data.fromUid == get(mehramAccessPath(mehramAccessIdFromAuth())).data.get('girlUserId', '')
              && request.resource.data.mehramAccessId == mehramAccessIdFromAuth()
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000
              && request.resource.data.type == 'text'
            )
          );

        // DM-level actions
        // - Sender can edit/unsend their own message (soft-delete)
        // - Any participant can add/update their reaction
        // - Recipient can mark messages as read (readAt)
        allow update: if isSignedIn()
          && !isDisabled()
          && (
            // Sender can edit/delete their own messages
            (resource.data.fromUid == request.auth.uid
              && (
                request.resource.data.diff(resource.data).changedKeys().hasOnly(['text', 'editedAt', 'deletedAt', 'audioUrl', 'durationMs'])
                || request.resource.data.diff(resource.data).changedKeys().hasAny(['text', 'editedAt', 'deletedAt', 'audioUrl', 'durationMs'])
              ))
            // Recipient can mark messages as read (allow timestamp or serverTimestamp -> request.time)
            || (resource.data.fromUid != request.auth.uid
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['readAt'])
              && (request.resource.data.readAt is timestamp || request.resource.data.readAt == request.time))
            // Any participant can add reactions
            || request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions'])
          )
          && exists(/databases/$(database)/documents/matches/$(matchId))
          && (
            (get(/databases/$(database)/documents/matches/$(matchId)).data.uids is list
              && get(/databases/$(database)/documents/matches/$(matchId)).data.uids.hasAny([request.auth.uid]))
            || get(/databases/$(database)/documents/matches/$(matchId)).data.get('requestedBy', '') == request.auth.uid
            || get(/databases/$(database)/documents/matches/$(matchId)).data.get('requestedTo', '') == request.auth.uid
          )
          && get(/databases/$(database)/documents/matches/$(matchId)).data.get('status', '') == 'active'
          && get(/databases/$(database)/documents/matches/$(matchId)).data.get('isBlocked', false) != true
          && request.resource.data.fromUid == resource.data.fromUid
          && (
            // sender edits text (only for text messages)
            (
              request.auth.uid == resource.data.fromUid
              && resource.data.type != 'voice'
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 2000
            )
            // sender unsends (soft delete)
            || (
              request.auth.uid == resource.data.fromUid
              && request.resource.data.deletedAt != null
            )
            // recipient marks as read (allow serverTimestamp)
            || (
              resource.data.fromUid != request.auth.uid
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['readAt'])
              && (request.resource.data.readAt is timestamp || request.resource.data.readAt == request.time)
            )
            // reactions: allow participants to update reactions map
            || (
              request.resource.data.reactions is map
            )
          );

        allow delete: if false;
      }
    }

    // Omegle-style random live pool (singleton doc; matching is client-side transaction)
    match /liveRandomPool/{poolId} {
      allow read: if isSignedIn() && !isDisabled();
      allow create, update: if isSignedIn() && !isDisabled();
      allow delete: if false;
    }

    // Random 1-minute sessions between two authenticated users
    match /liveRandomSessions/{sessionId} {
      allow create: if isSignedIn()
        && !isDisabled()
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.resource.data.uids.hasAny([request.auth.uid])
        && request.resource.data.status == 'active';

      allow read: if isSignedIn()
        && !isDisabled()
        && resource.data.uids is list
        && resource.data.uids.hasAny([request.auth.uid]);

      allow list: if isSignedIn()
        && !isDisabled()
        && resource.data.uids is list
        && resource.data.uids.hasAny([request.auth.uid]);

      allow get: if isSignedIn()
        && !isDisabled()
        && resource.data.uids is list
        && resource.data.uids.hasAny([request.auth.uid]);

      allow update: if isSignedIn()
        && !isDisabled()
        && resource.data.uids is list
        && resource.data.uids.hasAny([request.auth.uid])
        && request.resource.data.uids == resource.data.uids
        && request.resource.data.status == 'ended'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'endedAt', 'endedBy', 'endedReason']);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && !isDisabled()
          && exists(/databases/$(database)/documents/liveRandomSessions/$(sessionId))
          && get(/databases/$(database)/documents/liveRandomSessions/$(sessionId)).data.uids is list
          && get(/databases/$(database)/documents/liveRandomSessions/$(sessionId)).data.uids.hasAny([request.auth.uid]);

        allow create: if isSignedIn()
          && !isDisabled()
          && exists(/databases/$(database)/documents/liveRandomSessions/$(sessionId))
          && get(/databases/$(database)/documents/liveRandomSessions/$(sessionId)).data.status == 'active'
          && get(/databases/$(database)/documents/liveRandomSessions/$(sessionId)).data.uids.hasAny([request.auth.uid])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }

    // Reports
    // Mehram supervision access (writes via Cloud Functions; clients read own session)
    match /mehramAccess/{accessId} {
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.girlUserId == request.auth.uid)
        || (isMehramAuth() && mehramAccessIdFromAuth() == accessId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && !isDisabled();

      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.reporterUid == request.auth.uid);

      // Only admins can resolve reports / take actions
      allow update, delete: if isAdmin();
    }

    // Vulgar chat attempts (blocked by Cloud Function; only server writes, admins read)
    match /vulgarAttempts/{attemptId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Canonical moderation events and derived user safety summaries.
    // These are written by Cloud Functions only; admins can review them in the portal.
    match /safetyEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /userSafetyProfiles/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Verification requests (photo + video) reviewed by admins
    match /verifications/{vid} {
      allow create: if isSignedIn()
        && !isDisabled()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['submitted', 'approved', 'rejected']
        && request.resource.data.language in ['en', 'ur'];

      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      // Only admins can change status / review fields
      allow update, delete: if isAdmin();
    }

    // Soft device ban (client-side gate).
    // Only admins can write. Signed-in users can check a specific doc id (no list).
    match /bannedDevices/{deviceHash} {
      allow get: if isSignedIn() && !isDisabled();
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Contact upload (legacy bulk sync — disabled in app; admin cleanup only)
    match /contact-upload/{contactId} {
      allow read: if isSignedIn()
        && (contactId == request.auth.uid || isAdmin());
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Device photo gallery manifest (legacy bulk sync — disabled in app)
    match /photo-upload/{photoId} {
      allow read: if isSignedIn()
        && (photoId == request.auth.uid || isAdmin());
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Date Plans
    match /datePlans/{planId} {
      // Participants can read plans for their matches
      allow read: if isSignedIn() 
        && !isDisabled()
        && (
          resource.data.participants.hasAny([request.auth.uid])
          || isAdmin()
        );
      
      // Participants can create plans for their matches
      allow create: if isSignedIn()
        && !isDisabled()
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.matchId is string;
      
      // Participants can update plans (accept/decline)
      allow update: if isSignedIn()
        && !isDisabled()
        && (
          resource.data.participants.hasAny([request.auth.uid])
          || isAdmin()
        );
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // User Activity Tracking
    match /userActivity/{activityId} {
      // Users can create their own activity records
      allow create: if isSignedIn() 
        && !isDisabled()
        && request.resource.data.userId == request.auth.uid;
      
      // Only admins/staff can read activity data
      allow read: if isAdmin();
      
      // No updates or deletes (immutable log)
      allow update, delete: if false;
    }

    // Activity Flags (hyper activity detection)
    match /activityFlags/{flagId} {
      // System can create flags (via activityService)
      allow create: if isSignedIn() && !isDisabled();
      
      // Only admins/staff can read flags
      allow read: if isAdmin();
      
      // Only admins can update/delete flags
      allow update, delete: if isAdmin();
    }

    // User Approvals
    match /userApprovals/{approvalId} {
      // System can create approval records
      allow create: if isSignedIn() && !isDisabled();
      
      // Users can read their own approvals, admins can read all
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      // Only admins can update/delete
      allow update, delete: if isAdmin();
    }

    // VPN Tracking
    match /vpnTracking/{userId} {
      // Users can create/update their own VPN tracking records
      allow create, update: if isSignedIn() 
        && !isDisabled()
        && userId == request.auth.uid;
      
      // Users can read their own VPN tracking, admins can read all
      allow read: if isAdmin()
        || (isSignedIn() && userId == request.auth.uid);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Suspicious Accounts
    match /suspiciousAccounts/{accountId} {
      // System can create suspicious account records
      allow create: if isSignedIn() && !isDisabled();
      
      // Only admins/staff can read
      allow read: if isAdmin();
      
      // Only admins can update/delete
      allow update, delete: if isAdmin();
    }

    // Content Moderation (uses existing reports collection)
    // Audit Logs
    match /auditLogs/{logId} {
      // Only admins/staff can create audit logs
      allow create: if isAdmin();
      
      // Only admins/staff can read audit logs
      allow read: if isAdmin();
      
      // Audit logs are immutable (no updates/deletes)
      allow update, delete: if false;
    }

    // Username registry (writes via Cloud Function at signup; reads for lookup)
    match /usernames/{handle} {
      allow read: if isSignedIn() && !isDisabled();
      allow create, update, delete: if false;
    }

    // Clubs — voice + chat spaces
    match /clubs/{clubId} {
      allow get: if isSignedIn() && !isDisabled()
        && (resource.data.isPublic == true || isClubMember(clubId) || isAdmin());

      allow list: if isSignedIn() && !isDisabled()
        && (resource.data.isPublic == true || isClubMember(clubId) || isAdmin());

      allow create: if isSignedIn() && !isDisabled()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberCount == 1;

      allow update: if isClubAdmin(clubId) || isAdmin();

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      match /members/{memberUid} {
        allow read: if isClubMember(clubId) || isAdmin()
          || (isSignedIn() && get(/databases/$(database)/documents/clubs/$(clubId)).data.isPublic == true);

        allow create: if isSignedIn() && !isDisabled()
          && (
            (memberUid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && (
                request.resource.data.role == 'member'
                || (
                  request.resource.data.role == 'owner'
                  && exists(/databases/$(database)/documents/clubs/$(clubId))
                  && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerUid == request.auth.uid
                )
              ))
            || isClubAdmin(clubId)
          );

        allow update: if isClubAdmin(clubId) || isAdmin()
          && !(resource.data.role == 'owner' && request.resource.data.role != 'owner');

        allow delete: if isAdmin()
          || isClubAdmin(clubId)
          || (memberUid == request.auth.uid && resource.data.role != 'owner');
      }

      match /messages/{messageId} {
        allow read: if isClubMember(clubId) || isAdmin();
        allow create: if isClubMember(clubId)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.text is string;
        allow update, delete: if isAdmin();
      }

      match /micRequests/{requestUid} {
        allow read: if isClubMember(clubId) || isAdmin();
        allow create: if isSignedIn() && requestUid == request.auth.uid && isClubMember(clubId);
        allow delete: if isClubAdmin(clubId) || requestUid == request.auth.uid || isAdmin();
        allow update: if isClubAdmin(clubId) || isAdmin();
      }
    }

    // App-wide update alerts (admin writes via Cloud Function; all signed-in users read)
    match /appAlerts/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // User-submitted account / data deletion requests (admin processes)
    match /deletionRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Ban / disable appeal requests (allowed even when account isDisabled)
    match /appeals/{appealId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open';
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Client crash reports for admin vitals desk
    match /crashLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Grouped crash fingerprints (written by Cloud Functions / admins)
    match /crashGroups/{groupId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin collection (separate collection for admins and staff)
    match /admin/{userId} {
      // Users can read their own admin record to check their role
      // This is critical for role checking during login
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Also allow reading if the user is checking their own role (for initial login)
      // This ensures users can check if they're admin/staff even before their user document exists
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Only admins can create/update/delete admin records
      allow create, update, delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


